# Copy to .env and fill in your own values.
# Every value here is a placeholder — the public repository never contains a real key.

# ---------------------------------------------------------------------------
# MCP service
# ---------------------------------------------------------------------------

# Base URL of the MCP service. The script appends /mcp itself.
#   production : https://commerce.bitfund.ltd
#   trial      : https://staging.bitfund.ltd
MCP_URL=https://commerce.bitfund.ltd

# Your API key. Requested from the service provider; the plaintext is shown
# exactly once at issue time and cannot be retrieved afterwards.
# Keys are NOT shared between the trial and production environments.
MCP_API_KEY=ac_trial_xxxxxxxxxxxxxxxxxxxxxxxx

# ---------------------------------------------------------------------------
# Model provider (only needed by examples/shopping-agent)
# ---------------------------------------------------------------------------
# Any OpenAI-compatible /chat/completions endpoint works:
# MiniMax, DeepSeek, Qwen, OpenRouter, self-hosted vLLM, local Ollama, ...

LLM_BASE_URL=https://api.minimax.chat/v1
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxx
LLM_MODEL=MiniMax-M2

# Free-form label; only used to tag the User-Agent header.
LLM_PROVIDER=minimax

# Scenario tag used for the recommendation records this demo writes.
SCENARIO=demo-shopping-agent
